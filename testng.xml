<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Automation Suite" parallel="methods" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
        <listener class-name="com.qa.framework.utils.RetryListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>
    </test>

    <test name="PIM Tests">
        <classes>
            <class name="com.qa.tests.PimEmployeeListTest"/>
        </classes>
    </test>

    <test name="My Info Tests">
        <classes>
            <class name="com.qa.tests.MyInfoTest"/>
        </classes>
    </test>

</suite>
