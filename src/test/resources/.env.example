# Copy this file to .env (or export these as real environment variables /
# -D system properties in CI) and fill in real values. Never commit a real
# .env file - it is excluded via .gitignore.
#
# This framework does not auto-load .env files at runtime; wire these into
# your shell, CI secrets, or pass them as -D<key>=<value> to Maven, e.g.:
#   mvn clean test -Denv=qa -Dvalid.username=Admin -Dvalid.password=admin123

# Environment selector: loads config-<ENV>.properties (defaults to "qa")
ENV=qa

# Target application
BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php/auth/login

# Browser execution
BROWSER=chrome
HEADLESS=true

# Test credentials (placeholder - the public OrangeHRM demo resets periodically)
VALID_USERNAME=Admin
VALID_PASSWORD=admin123
